# ==============================================================================
# DATABASE
# ==============================================================================

# --- Local Postgres (Canonical Development Target) ---
# This is the expected target for autonomous agents and local development.
# Docker run command for fresh local dev target:
# docker run -d --name beautybook3-pg -e POSTGRES_USER=beautybook -e POSTGRES_PASSWORD=beautybook -e POSTGRES_DB=beautybook_dev -p 5433:5432 postgres:16
DATABASE_URL="postgresql://beautybook:beautybook@localhost:5433/beautybook_dev?sslmode=disable"

# --- Hosted Supabase (production / staging) ---
# Hosted runtime DATABASE_URL is not the autonomous-agent mutation target.
# Autonomous agents must follow AGENTS.md; this file does not grant mutation authority.
# Note: The technical local DB guard in lib/test-only-local-db.ts is broader than agent policy.
#
# Supabase session pooler (port 5432). Use beautybook_prisma or your pooler user from the dashboard.
# Pooler hostname is region-specific (e.g. aws-0-eu-central-1 for eu-central-1) — copy from the dashboard.
# Not the transaction pooler (port 6543) and not the direct host (db.*.supabase.co) unless you use postgres.[REF].
# DATABASE_URL="postgresql://beautybook_prisma.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# ==============================================================================
# APPLICATION & AUTHENTICATION
# ==============================================================================

APP_BASE_URL="http://127.0.0.1:3000"
# In production, APP_BASE_URL is required and non-loopback production URLs must use HTTPS.

BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# ==============================================================================
# RATE LIMITING
# ==============================================================================

# RATE_LIMIT_SECRET is required in production and must be a strong secret.
# It is optional in local development because the source code has a development fallback.
# RATE_LIMIT_SECRET=""

# ==============================================================================
# TRANSACTIONAL EMAIL
# ==============================================================================

# EMAIL_PROVIDER: "smtp" (dev/Mailpit), "resend" (production), or "memory" (test/CI)
# EMAIL_PROVIDER="smtp"
# EMAIL_FROM="BeautyBook <noreply@beautybook.ph>"

# Resend Provider configuration (required if EMAIL_PROVIDER="resend")
# RESEND_API_KEY="re_..."

# SMTP Provider configuration (required if EMAIL_PROVIDER="smtp")
# SMTP_HOST="127.0.0.1"
# SMTP_PORT="1025"
# SMTP_USER="optional-username"
# SMTP_PASS="optional-password"
