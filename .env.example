# --- Hosted Supabase (production / staging) ---
# Supabase session pooler (port 5432). Use beautybook_prisma or your pooler user from the dashboard.
# Pooler hostname is region-specific (e.g. aws-0-eu-central-1 for eu-central-1) — copy from the dashboard.
# Not the transaction pooler (port 6543) and not the direct host (db.*.supabase.co) unless you use postgres.[REF].
DATABASE_URL="postgresql://beautybook_prisma.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# --- Local Postgres (fastest for migrate / verify / e2e) ---
# docker run -d --name beautybook3-pg -e POSTGRES_USER=beautybook -e POSTGRES_PASSWORD=beautybook -e POSTGRES_DB=beautybook -p 5433:5432 postgres:16
# DATABASE_URL="postgresql://beautybook:beautybook@localhost:5433/beautybook?sslmode=disable"

BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Seed, verify, and Playwright global setup refuse any DATABASE_URL that is not
# an approved local test/dev database (localhost/127.0.0.1, approved test DB).
# There is no remote bypass.

# --- Transactional Email ---
# EMAIL_PROVIDER="smtp" # "smtp" (dev/Mailpit), "resend" (production), or "memory" (test/CI)
# APP_BASE_URL="http://127.0.0.1:3000"
# EMAIL_FROM="BeautyBook <noreply@beautybook.ph>"
# RESEND_API_KEY="re_..."
# SMTP_HOST="127.0.0.1"
# SMTP_PORT="1025"
